// SAMPARK backend — Prisma schema (Phase 1).
// Field names are camelCase (matching the camelCase wire entity contract) and mapped
// to snake_case columns. Enum values are lowercase to serialize verbatim on the wire
// (per ADR / CLAUDE.md rule 10). All primary domain tables carry a soft-delete column.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (lowercase wire values; CadreFilter keeps client acronyms) ──────────

enum Role {
  super_admin
  admin
  officer
  viewer
}

enum CadreCategory {
  surrendered
  jail
  thana
}

enum CadreFilter {
  DVCM
  ACM
  PM
}

enum AlertLevel {
  critical
  warning
  normal
}

// ADR-019. Classifies WHERE a cadre surrendered relative to Bijapur, which the
// dashboard splits into two tiles. Deliberately a separate column from
// `surrenderLocation`: that field is free text recording the place ("थाना
// नारायणपुर"), not a classification, and it is null for cadres who never
// surrendered. Null here means "not applicable / not yet classified" — only
// `category = surrendered` rows carry a value.
enum SurrenderOrigin {
  district // Bijapur district
  other // another district or state
}

// This task (dashboard "दीगर जिला/राज्य" tabs). Sub-classifies the `other` bucket
// of SurrenderOrigin into the two tabs the home-dashboard card and create-cadre
// form now show. Only meaningful when surrenderOrigin = 'other' — same nullable,
// scoped-to-parent-value pattern as SurrenderOrigin itself relative to category.
enum OtherOriginType {
  other_district // another district (not Bijapur)
  other_state // another state
}

// ADR-026. Lifecycle of an officer/admin-proposed edit to a cadre record.
// `applied` is terminal and means the change is live on the cadre; `approved`
// is never a resting state (approval and application happen in one transaction),
// so it is deliberately absent — a request that says "approved" but whose value
// is not on the cadre would be the exact class of lie this project keeps undoing.
enum ChangeRequestStatus {
  pending
  applied
  rejected
  cancelled // withdrawn by the submitter before it was decided
  stale // the underlying value moved after submission; never applied
}

// Cadre creation ladder. Deliberately NOT ChangeRequestStatus: `stale` means "the old
// value drifted since submission", and a create request has no old value to drift
// from — nothing exists yet to compare against. A near-duplicate of an existing
// cadre is surfaced to the approver as a non-blocking WARNING (computed live, never
// persisted), not a rejection state, so there is no status for it either.
enum CreateRequestStatus {
  pending
  applied
  rejected
  cancelled
}

enum ReportingPlace {
  thana
  village
}

enum PersonStatus {
  alive
  dead
}

// ADR-038. The register's लिंग column, exactly two clean values. Lowercase to
// serialize verbatim on the wire (CLAUDE.md rule 10), like every other enum here.
// Caste is deliberately NOT an enum: it is free text with dozens of open-ended
// values, and freezing it into an enum would reject the next spelling the register
// records.
enum Gender {
  male
  female
}

// In-app notification inbox (v1), also delivered as real push via AWS SNS + FCM V1
// (ADR-048 — a deliberate, narrow, documented exception to root CLAUDE.md's data
// residency rule; see BC-THESIS-SAMPARK.md). Lowercase to serialize verbatim on the
// wire (CLAUDE.md rule 10/11), like every other enum here.
enum NotificationType {
  report_overdue
  cadre_change_outcome
  cadre_create_outcome
  thana_transfer
  broadcast
}

// ADR-046. The register's कैटेगरी column — a priority GRADE, distinct from
// `category` (surrendered/jail/thana, which records station-status). A/B/C are
// priority tiers (A > B > C) and drive the per-category reporting cadence
// (`cadenceDaysFor`: A→30d, B→60d, C→90d); jail/death carry no reporting cadence.
//
// DELIBERATE WIRE DEVIATION (CLAUDE.md rule 11 says enums serialize lowercase):
// A/B/C stay UPPERCASE on the wire because the uppercase letters ARE the register's
// grades and every officer's mental model. Lowercasing them would make the API
// disagree with the paper record for no benefit. `jail`/`death` are not grades and
// stay lowercase like every other enum. See ADR-046.
enum PriorityCategory {
  A
  B
  C
  jail
  death
}

// This task (item 7). A SEPARATE, permanent classification — deliberately NOT a
// value added to PriorityCategory or CadreCategory (confirmed with the
// maintainer): फौत (deceased) here is its own field, distinct from
// PriorityCategory's existing `death` grade, and the other three (शासकीय नौकरी /
// GS / अन्य जिले में निवासरत) never were priority grades at all. Any of the five
// is a PERMANENT mark meaning "no attendance/reporting required going forward" —
// see recency.ts's exemption and reports.service.ts's ADR-049-style block.
// `untraceable` (अप्राप्य, later task) is the fifth: a cadre nobody can currently
// locate carries the same reporting exemption as the other four.
enum PermanentStatus {
  deceased
  government_job
  gs
  living_elsewhere
  untraceable
}

// This task. A LIVE, reversible custody state — deliberately NOT folded into
// `CadreCategory.jail` (that is the register/list a cadre belongs to —
// surrendered/jail/thana — set once at import, never a day-to-day toggle) and
// NOT into `PriorityCategory.jail` (a reporting-cadence grade). A cadre in the
// `surrendered` or `thana` register can be picked back up into custody, and one
// in the `jail` register can be released — this field tracks THAT fact, on any
// cadre, independent of which register they're filed under. Null (the default
// for every cadre, including ones already in the jail register) means "never
// explicitly flagged through the हिरासत की स्थिति menu" — the field stays
// hidden on the profile until an officer sets it.
enum CustodyStatus {
  in_custody
  released
}

// ─── Users (officers + admins) ─────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  // ADR-042. The INSTITUTIONAL ID — e.g. "SDOPKUTRU01", "SHOGNGL07" — NOT a person's
  // name. Real names are deliberately not stored anywhere (client decision). Unique
  // because it is the account's identity AND the upsert key for POST /users/import.
  //
  // Consequence, recorded here because it is easy to forget at a call site: every
  // audit row, change request and report attributes to this ID, so accountability is
  // only as granular as the ID. An ID held by several people resolves to the ID, never
  // to the person. See ADR-042 Consequences.
  name            String    @unique
  // ADR-042. Nullable: the SMS-OTP track is gone and these institutional accounts have
  // no phone. Kept (unique, nullable) rather than dropped so historical rows and any
  // future contact use keep a home — Postgres allows many NULLs under a unique index.
  phone           String?   @unique
  // ADR-042. The login credential. `<id-lowercased>@sampark.internal` — a non-routable
  // ICANN-reserved private TLD; these inboxes do not exist, which is WHY password
  // reset is super_admin-driven (Phase B) and never self-service by email.
  email           String?   @unique
  // ADR-042. scrypt (node:crypto) — see lib/password.ts. NULL means "no password set
  // yet": an imported account cannot log in until a super_admin sets one (Phase B).
  passwordHash    String?   @map("password_hash")
  // ADR-042/SDR-001. TOTP applies to admin + super_admin ONLY (14 accounts), never the
  // 60 field IDs. `totpConfirmedAt` distinguishes "secret generated, enrolment never
  // completed" from "enrolled" — without it a half-finished enrolment locks the
  // account out, because login would stop re-offering the provisioning URI.
  totpSecret      String?   @map("totp_secret")
  totpConfirmedAt DateTime? @map("totp_confirmed_at")
  role            Role      @default(officer)
  designation     String?
  // ADR-042. Scope fields for the org hierarchy → Role mapping:
  //   HQ         = super_admin, thana + subDivision BOTH null  -> unrestricted
  //   SDOP       = admin,       subDivision set                -> that sub-division
  //   Thana/SHO  = officer,     thana set                      -> that thana
  // These are compared against Cadre.thana / Cadre.subDivision, so the values must
  // match those columns EXACTLY — see Phase 0 normalisation (ADR-043).
  thana           String?
  subDivision     String?   @map("sub_division")
  avatarUrl       String?   @map("avatar_url")
  badgeImageUrl   String?   @map("badge_image_url")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  reports        Report[]       @relation("ReportReporter")
  assignedCadres Cadre[]        @relation("CadreAssignedOfficer")
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  deviceTokens   DeviceToken[]

  lastEditedCadres     Cadre[]              @relation("CadreLastEditor") // ADR-027
  // ADR-026
  submittedChanges     CadreChangeRequest[] @relation("ChangeSubmitter")
  adminApprovedChanges CadreChangeRequest[] @relation("ChangeAdminApprover")
  superApprovedChanges CadreChangeRequest[] @relation("ChangeSuperAdminApprover")
  decidedChanges       CadreChangeRequest[] @relation("ChangeDecider")

  // Cadre creation ladder (mirrors the change-request relations above).
  submittedCreateRequests     CadreCreateRequest[] @relation("CreateReqSubmitter")
  adminApprovedCreateRequests CadreCreateRequest[] @relation("CreateReqAdminApprover")
  superApprovedCreateRequests CadreCreateRequest[] @relation("CreateReqSuperAdminApprover")
  decidedCreateRequests       CadreCreateRequest[] @relation("CreateReqDecider")

  configUpdates ConfigEntry[] @relation("ConfigUpdatedBy") // ADR-059

  @@map("users")
}

// ─── Cadres (surrendered / jail / thana persons) ───────────────────────────────

model Cadre {
  id                 Int               @id @default(autoincrement())
  // ADR-025. The official register serial number carried over from the paper records.
  // Deliberately NOT `id`: `id` is a surrogate autoincrement PK with gaps from
  // deletes, and the ~1,790-row import will reassign every PK — a "serial number"
  // an officer has written in a register must not change under them. Nullable
  // because existing rows predate the import that supplies it; unique because a
  // register number that repeats identifies nothing (a failed import surfacing
  // duplicate serials is the point, not a problem).
  serialNumber       String?           @unique @map("serial_number")
  name               String
  phone              String
  thana              String
  currentAddress     String            @map("current_address")
  permanentAddress   String?           @map("permanent_address")
  // This task, item 5. The name of the village the cadre is CURRENTLY residing in —
  // distinct from currentAddress (a free-text full address) and from thana/
  // subDivision/district (jurisdiction, not a village name). Nullable: no existing
  // data source supplies it yet. Approval-gated like every other fact of record
  // (cadre-changes.policy.ts).
  residingVillage    String?           @map("residing_village")
  designation        String
  category           CadreCategory
  // ADR-046. Priority GRADE from the register's कैटेगरी column — separate from
  // `category` above. Drives the per-category reporting cadence (cadenceDaysFor).
  // Nullable because existing rows predate it; the CSV backfill (category-backfill
  // route) and the ADR-038 import supply it — same posture as serialNumber/dateOfBirth.
  priorityCategory   PriorityCategory? @map("priority_category")
  // This task (item 7). Separate from priorityCategory — see the enum's comment.
  // Nullable; null = no permanent mark. Approval-gated (cadre-changes.policy.ts).
  permanentStatus    PermanentStatus?  @map("permanent_status")
  // This task. Only meaningful alongside permanentStatus='deceased' — set by
  // report-time death sync (a report's person_status='dead' proposes BOTH
  // fields together, one bundled change, so the ladder can never approve a
  // date without the mark or vice versa). Approval-gated like every other
  // fact of record; @db.Date for the same reason as dateOfBirth below (a
  // calendar date, not a moment).
  deceasedDate       DateTime?         @map("deceased_date") @db.Date
  // This task. See CustodyStatus's own comment — null until an officer
  // explicitly flags it via the हिरासत की स्थिति menu; approval-gated like
  // every other fact of record.
  custodyStatus      CustodyStatus?    @map("custody_status")
  filter             CadreFilter?
  alertLevel         AlertLevel        @map("alert_level")
  avatarUrl          String?           @map("avatar_url")
  alertDate          DateTime?         @map("alert_date")
  incident           String?
  verificationOffice String?           @map("verification_office")
  supervisoryOffice  String?           @map("supervisory_office")
  alertTag           String?           @map("alert_tag")
  aliases            String[]
  surrenderDate      DateTime?         @map("surrender_date")
  surrenderLocation  String?           @map("surrender_location")
  surrenderOrigin    SurrenderOrigin?  @map("surrender_origin")
  // This task. Only set when surrenderOrigin = 'other'; null otherwise (including
  // for the district-origin and non-surrendered cases). See enum comment.
  otherOriginType    OtherOriginType?  @map("other_origin_type")
  surrenderYear      String?           @map("surrender_year")
  regiment           String?
  familyGroupInfo    String?           @map("family_group_info")
  subDivision        String?           @map("sub_division")
  // ADR-040. Home district (dropdown on the edit form: the 7 Bastar-region districts).
  // Nullable like subDivision — existing rows predate it; the Apps Script backfills it.
  district           String?           @map("district")
  // ADR-036. Date of birth, stored — age is DERIVED from it on read, never stored.
  // A stored age is wrong the day after it is written and has no way to know it;
  // a birth date is a fact that does not rot. Nullable: existing rows predate it and
  // the ~1,790-row import supplies it later. Manually enterable now (BE#6), not
  // gated on the import.
  dateOfBirth        DateTime?         @map("date_of_birth") @db.Date
  // ADR-036. Immediate family, as three plain columns (BE#7). Deliberately NOT a
  // child table or a repeatable relation list: the register records exactly these
  // three names, and a `cadre_relations` table would be schema weight for a
  // fixed-arity fact. `familyGroupInfo` above stays — it is the free-text
  // "who they live with" note, a different thing from a parent's name.
  fatherName         String?           @map("father_name")
  motherName         String?           @map("mother_name")
  spouseName         String?           @map("spouse_name")
  // ADR-038. Demographic facts carried over from the paper register by the one-time
  // historical import (Design-Docs#7). Both nullable for the same reason
  // serialNumber and dateOfBirth are: existing rows predate the import that supplies
  // them, and caste is only ~82% filled in the source. `gender` is a two-value enum
  // (पुरूष/महिला); `caste` is free text (जाति), never an enum — see the Gender enum note.
  gender             Gender?           @map("gender")
  caste              String?           @map("caste")
  // ADR-029. The four hardcopy documents, tracked INDIVIDUALLY. ADR-026 shipped
  // these as one `hardcopyDocsExist` boolean; the client asked for them separately,
  // and they were right — "the paperwork exists" is unanswerable when the Aadhaar
  // is on file and the agreement letter is not. One flag forced an officer to lie
  // in one direction or the other.
  //
  // Each goes through the approval chain like any other cadre fact: ticking one is
  // asserting a document physically exists, which is a claim someone above the
  // officer signs off on. Default false = "not confirmed present", never null — a
  // tri-state nobody asked for.
  hasAadhaar         Boolean           @default(false) @map("has_aadhaar")
  hasBankAccount     Boolean           @default(false) @map("has_bank_account")
  hasAbProforma      Boolean           @default(false) @map("has_ab_proforma")
  hasAgreementLetter Boolean           @default(false) @map("has_agreement_letter")
  // ADR-029. Durable S3 key for the cadre's photo. ADR-016's lesson: store the KEY,
  // never a presigned URL (which expires ≤7d and would rot in the column). The
  // legacy `avatarUrl` above stays for rows that predate this; the serializer
  // prefers a freshly-signed `avatarKey` and falls back to it.
  avatarKey          String?           @map("avatar_key")
  // ADR-054. Two more independent photo slots (up to 3 total). Each is its own
  // nullable S3 key — same pattern as `avatarKey` above, not an array: the
  // change-request lock/apply engine keys off literal column names, so a real
  // column per slot gives each photo its own independent approval lock (matching
  // the four-hardcopy-documents precedent, ADR-029) instead of one lock across all
  // three, which an `avatarKeys[]` array would have forced.
  avatarKey2         String?           @map("avatar_key_2")
  avatarKey3         String?           @map("avatar_key_3")
  assignedOfficerId  Int?              @map("assigned_officer_id")
  // ADR-027. Who last changed this record's contents, and when. Deliberately NOT
  // `updatedAt`: that moves on every write including assignment transfers, so it
  // cannot answer "has someone edited this cadre's details recently?" — which is
  // the question an officer asks before proposing an edit of their own.
  //
  // Denormalised on purpose, unlike nextReportingDueAt (ADR-022, derived). This is
  // not a function of existing data — it is a fact recorded at write time, and only
  // the two write paths (a change request applying, a direct tag/alias write) ever
  // set it. Nothing else can make it drift.
  lastEditedAt       DateTime?         @map("last_edited_at")
  lastEditedById     Int?              @map("last_edited_by_id")
  // In-app notification escalation dedupe. Mirrors the lastEditedAt precedent above: a
  // fact recorded AT SCAN TIME by the escalation worker, not derived from existing data
  // (the tier itself is derived on read — see lib/recency.ts). Null = not currently
  // escalated (reset when a new report lands and the cadre returns to `current`). Plain
  // string, not a DB enum — like alertTag, the value set ('overdue1m'|'overdue2m'|
  // 'overdue3m') is owned by application code (RecencyTier), not a DB-level concept.
  // Lets the worker notify once per tier ENTRY instead of re-firing every scan.
  lastEscalationTier String?           @map("last_escalation_tier")
  deletedAt          DateTime?         @map("deleted_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  assignedOfficer User?                @relation("CadreAssignedOfficer", fields: [assignedOfficerId], references: [id])
  lastEditedBy    User?                @relation("CadreLastEditor", fields: [lastEditedById], references: [id]) // ADR-027
  reports         Report[]
  changeRequests  CadreChangeRequest[] // ADR-026
  notifications   Notification[]
  // The create request this cadre was born from — absent for seeded/imported rows.
  createRequest   CadreCreateRequest?  @relation("CadreFromCreateRequest")

  @@index([category])
  @@index([alertLevel])
  @@index([assignedOfficerId])
  // ADR-046. The recency queries filter on priorityCategory (per-category cadence).
  @@index([priorityCategory])
  // This task (item 7). recency.ts filters on permanentStatus the same way.
  @@index([permanentStatus])
  // The two surrendered dashboard tiles both filter category + origin together.
  @@index([category, surrenderOrigin])
  // This task. The दीगर जिला/राज्य tabs drill one level further into that filter.
  @@index([category, surrenderOrigin, otherOriginType])
  @@map("cadres")
}

// ─── Reports (field reporting against a cadre) ─────────────────────────────────

model Report {
  id                      Int            @id @default(autoincrement())
  cadreId                 Int            @map("cadre_id")
  reportingPlace          ReportingPlace @map("reporting_place")
  // This task. Nullable — a personStatus='dead' report needs none of these
  // three (see reports.schema.ts's superRefine): there is no "current"
  // location/phone/activity for a person the officer is reporting as dead,
  // only अन्य जानकारी (otherInformation) describing what was learned. Every
  // personStatus='alive' report still requires all three, enforced at the
  // Zod boundary, not here.
  specificLocation        String?        @map("specific_location")
  personStatus            PersonStatus   @map("person_status")
  currentPhone            String?        @map("current_phone")
  // ADR-050. This is the "वर्तमान में क्या कार्य कर रहा है" (current activity) field
  // of the three-field split — kept as this SAME column, not a new one. The old
  // single "वर्तमान विवरण" form's placeholder already asked for exactly this
  // ("वर्तमान कार्य दर्ज करें"), so every pre-split row's value is already the
  // correct answer to the new, narrower question; nothing needed migrating.
  currentActivity         String?        @map("current_activity")
  // ADR-050. New: "अन्य माओवादियों से समर्पण हुआ विवरण" — details of surrender in
  // relation to other Maoists. Nullable — existing rows predate the split.
  surrenderNetworkDetails String?        @map("surrender_network_details")
  // ADR-050. New: "अन्य जानकारी" — the free-form catch-all. Nullable, same reason.
  otherInformation        String?        @map("other_information")
  // Legacy single-photo URL (may be an expired presigned URL on old rows). New
  // writes populate photoKeys instead; kept for backward-compatible reads.
  photoUrl                String?        @map("photo_url")
  // ADR-016: durable S3 object keys for report photos. Keys are stored (never the
  // presigned URL, which expires ≤7d); reads re-sign each key to a fresh GET URL.
  photoKeys               String[]       @default([]) @map("photo_keys")
  gpsLatitude             Float?         @map("gps_latitude")
  gpsLongitude            Float?         @map("gps_longitude")
  gpsAddress              String?        @map("gps_address")
  isHomeAddress           Boolean?       @map("is_home_address")
  reportedById            Int            @map("reported_by_id")
  reportedAt              DateTime       @default(now()) @map("reported_at")
  syncedAt                DateTime?      @map("synced_at")
  // ADR-013: client-supplied UUID; unique + retained for the report's lifetime (no expiry).
  idempotencyKey          String?        @unique @map("idempotency_key")
  deletedAt               DateTime?      @map("deleted_at")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  cadre      Cadre @relation(fields: [cadreId], references: [id])
  reportedBy User  @relation("ReportReporter", fields: [reportedById], references: [id])

  @@index([cadreId])
  @@index([reportedById])
  @@map("reports")
}

// ─── Cadre change requests (ADR-026) ───────────────────────────────────────────
//
// An officer/admin-proposed edit to a CADRE record, held until everyone above the
// submitter has signed off. Scope is deliberately the cadre, not the user account:
// officers do not edit their own profile through this.
//
// The approval ladder is "every role above you must approve":
//   officer      -> admin -> super_admin   (needsAdmin + needsSuperAdmin)
//   admin        -> super_admin            (needsSuperAdmin)
//   super_admin  -> applied immediately    (never reaches this table)
//   viewer       -> cannot submit
//
// The two required-flags are frozen ONTO THE ROW at submission time rather than
// re-derived from the submitter's current role on each read: if an officer is
// promoted to admin while their change sits pending, the change must still need
// the approvals it needed when it was made. Re-deriving would silently shorten
// the chain retroactively.
model CadreChangeRequest {
  id      Int @id @default(autoincrement())
  cadreId Int @map("cadre_id")

  // One request = one logical submission = a SET of field changes, applied or
  // rejected as a unit. Shape: { "<cadreField>": { "old": <json>, "new": <json> } }.
  // Not one row per field: a profile edit touches several at once, and per-field
  // rows let an approver half-approve an edit into a state the submitter never
  // proposed. `old` is the value read at submission time and is re-checked before
  // apply — an approval two days later must not clobber someone else's newer edit.
  changes Json

  submittedById Int      @map("submitted_by_id")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  // Free-text reason from the field ("नंबर बदल गया है"). Optional.
  note          String?

  status ChangeRequestStatus @default(pending)

  needsAdmin      Boolean @default(true) @map("needs_admin")
  needsSuperAdmin Boolean @default(true) @map("needs_super_admin")

  adminApprovedById      Int?      @map("admin_approved_by_id")
  adminApprovedAt        DateTime? @map("admin_approved_at")
  superAdminApprovedById Int?      @map("super_admin_approved_by_id")
  superAdminApprovedAt   DateTime? @map("super_admin_approved_at")

  // Terminal outcomes. `decidedReason` carries a rejection reason — an officer who
  // is told only "rejected" learns nothing and will just resubmit.
  decidedAt     DateTime? @map("decided_at")
  decidedById   Int?      @map("decided_by_id")
  decidedReason String?   @map("decided_reason")

  // Sync module (extends ADR-013 to this entity). A device offline for weeks
  // queues a change-request submission in its local outbox and may replay it —
  // same problem ADR-013 solved for reports. Client-generated UUID v4, unique,
  // retained for the request's lifetime, no expiry: `submit()` dedupes on it,
  // returning the existing row on a replay instead of a second pending request.
  idempotencyKey String? @unique @map("idempotency_key")

  // This task. Set only by report-time death sync (reports.service.ts) — the
  // ONE report whose person_status='dead' triggered this proposal. A bare id,
  // no Prisma relation (same lightweight-reference style as Notification's
  // cadreChangeId): deleting a report must never cascade-touch this row, only
  // reports.service.ts's remove() explicitly cancels a still-PENDING one found
  // by this id. Null for every change proposed any other way.
  sourceReportId Int? @map("source_report_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cadre                Cadre          @relation(fields: [cadreId], references: [id])
  submittedBy          User           @relation("ChangeSubmitter", fields: [submittedById], references: [id])
  adminApprovedBy      User?          @relation("ChangeAdminApprover", fields: [adminApprovedById], references: [id])
  superAdminApprovedBy User?          @relation("ChangeSuperAdminApprover", fields: [superAdminApprovedById], references: [id])
  decidedBy            User?          @relation("ChangeDecider", fields: [decidedById], references: [id])
  notifications        Notification[]

  // The approver queue reads pending-first, newest-first.
  @@index([status, submittedAt])
  @@index([cadreId])
  @@index([submittedById])
  @@index([sourceReportId])
  @@map("cadre_change_requests")
}

// Cadre CREATION under the same two-level approval ladder as CadreChangeRequest
// (ADR-026/027/028), for a record that does not exist yet. Two structural
// differences from CadreChangeRequest, both because there is no existing cadre:
//   - `draft` (the whole proposed record) replaces `changes` (an {old,new} diff) —
//     there is no "old" value for a row that doesn't exist.
//   - `thana` is denormalised straight from `draft.thana`, since there is no `cadre`
//     relation yet to read it from; it exists purely so the approver queue and the
//     submit-time jurisdiction check can scope on it the way cadreScopeWhere does
//     for CadreChangeRequest via its cadre relation.
model CadreCreateRequest {
  id Int @id @default(autoincrement())

  // The full proposed new-cadre record, camelCase keys matching Cadre columns (see
  // cadre-create-requests.schema.ts's createCadreDraftSchema for the validated shape) —
  // same keying convention as CadreChangeRequest.changes' per-field entries.
  draft Json

  thana String

  submittedById Int      @map("submitted_by_id")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  note          String?

  status CreateRequestStatus @default(pending)

  needsAdmin      Boolean @default(true) @map("needs_admin")
  needsSuperAdmin Boolean @default(true) @map("needs_super_admin")

  adminApprovedById      Int?      @map("admin_approved_by_id")
  adminApprovedAt        DateTime? @map("admin_approved_at")
  superAdminApprovedById Int?      @map("super_admin_approved_by_id")
  superAdminApprovedAt   DateTime? @map("super_admin_approved_at")

  decidedAt     DateTime? @map("decided_at")
  decidedById   Int?      @map("decided_by_id")
  decidedReason String?   @map("decided_reason")

  // Populated ONLY on apply — the real Cadre row this request produced. @unique: one
  // create request can never produce two cadres.
  cadreId Int? @unique @map("cadre_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cadre                Cadre?         @relation("CadreFromCreateRequest", fields: [cadreId], references: [id])
  submittedBy          User           @relation("CreateReqSubmitter", fields: [submittedById], references: [id])
  adminApprovedBy      User?          @relation("CreateReqAdminApprover", fields: [adminApprovedById], references: [id])
  superAdminApprovedBy User?          @relation("CreateReqSuperAdminApprover", fields: [superAdminApprovedById], references: [id])
  decidedBy            User?          @relation("CreateReqDecider", fields: [decidedById], references: [id])
  notifications        Notification[]

  @@index([status, submittedAt])
  @@index([submittedById])
  @@index([thana])
  @@map("cadre_create_requests")
}

// ─── Auth support ──────────────────────────────────────────────────────────────

// ADR-042. `OtpChallenge` is GONE. SMS-OTP was the officer login track (ADR-012); it
// is removed entirely in favour of email+password, so the challenge table has no
// remaining reader or writer and the migration drops it. Nothing referenced it by FK.

// SDR-002. Account-level brute-force lockout.
//
// Keyed on the SUBMITTED EMAIL STRING, deliberately NOT on a user row. If only real
// accounts could lock, a 423 would itself answer "does this account exist?" — and with
// IDs guessable by construction (SHOGNGL01…10) that is a free enumeration oracle. An
// unknown email locks exactly the same way, so 423 reveals nothing while still telling a
// genuinely locked-out officer the truth instead of leaving them retyping a correct
// password against a generic 401.
model LoginAttempt {
  email        String    @id
  failedCount  Int       @default(0) @map("failed_count")
  lastFailedAt DateTime  @default(now()) @map("last_failed_at")
  // Null = not locked. Set when failedCount crosses the threshold.
  lockedUntil  DateTime? @map("locked_until")

  @@map("login_attempts")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Audit trail (append-only, hash-chained) ───────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  prevHash   String   @map("prev_hash")
  hash       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  // Sync module. `GET /sync/pull` finds cadres that moved OUT of a caller's thana
  // scope since their last pull (a thana transfer, unlike a soft-delete, leaves
  // `Cadre.deletedAt` null, so the normal tombstone query can't see it) by scanning
  // audit rows for `cadre.thana_transfer` since a cursor — see sync.service.ts.
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Transactional outbox ──────────────────────────────────────────────────────

model OutboxEvent {
  id            Int       @id @default(autoincrement())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@index([publishedAt])
  @@map("outbox_events")
}

// ─── Sheet sync (ADR-057/058/059) ──────────────────────────────────────────────

// Singleton row (the service always targets id 1) holding the ONE non-secret
// connection setting the Configuration page manages: the Apps Script Web App
// deployment URL the sheets-sync HTTP client calls. The shared-secret bearer
// token that authenticates those calls is NOT here — it is hand-provisioned
// into Secrets Manager (SYNC_API_KEY env var), never web-managed (ADR-059).
model ConfigEntry {
  id            Int      @id @default(autoincrement())
  sheetsSyncUrl String?  @map("sheets_sync_url")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedById   Int?     @map("updated_by_id")

  updatedBy User? @relation("ConfigUpdatedBy", fields: [updatedById], references: [id])

  @@map("config")
}

// Per-attempt sync-result logging (ADR-057 §5 / ADR-058 §6) — HQ needs to see
// what synced when and what failed, the same per-row-result discipline the
// register imports (ADR-038/045) already established. One row per attempt: an
// outbox-driven user.* push logs one row per event; a cadre.export batch logs
// one row for the whole run, with per-row detail in `detail`.
model SyncLog {
  id        Int      @id @default(autoincrement())
  eventType String   @map("event_type") // 'user.created' | 'user.updated' | 'user.deactivated' | 'cadre.export' | 'cadre.preview'
  // The User.name for a user.* row, or a batch label for cadre.export — deliberately
  // NOT a foreign key: the target may be deleted or the export spans many cadres, and
  // this log must stay readable even after the row it describes is gone.
  targetKey String?  @map("target_key")
  status    String // 'success' | 'error'
  error     String?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sync_log")
}

// ─── Notifications (in-app inbox + real push via ADR-048) ─────────────────────

model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  type          NotificationType
  // Server-templated Hindi copy (src/lib/notification-copy.ts), written once at
  // creation — never re-derived client-side.
  title         String
  body          String
  cadreId              Int?             @map("cadre_id")
  cadreChangeId        Int?             @map("cadre_change_id")
  cadreCreateRequestId Int?             @map("cadre_create_request_id")
  // Extra render-time facts that aren't relations (tier label, thana names, reject
  // reason) — also what rides along in the SNS/FCM push payload's `data` field.
  data          Json?
  readAt        DateTime?        @map("read_at")
  deletedAt     DateTime?        @map("deleted_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user              User                @relation(fields: [userId], references: [id])
  cadre             Cadre?              @relation(fields: [cadreId], references: [id])
  cadreChange       CadreChangeRequest? @relation(fields: [cadreChangeId], references: [id])
  cadreCreateRequest CadreCreateRequest? @relation(fields: [cadreCreateRequestId], references: [id])

  // The unread-count/list query: WHERE userId = ? AND readAt IS NULL ORDER BY createdAt DESC.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ADR-048. One row per physical app install (a raw FCM device registration token),
// used to deliver a Notification as a real push via AWS SNS.
model DeviceToken {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  // Globally unique, NOT a composite (userId, token) key: SNS's CreatePlatformEndpoint
  // is idempotent per token, so one token maps to exactly one endpointArn regardless of
  // which user "owns" it in our DB. Re-registering the same token under a different user
  // (a handset handed to a new officer) REASSIGNS this row rather than colliding or
  // orphaning a second one.
  token       String    @unique
  endpointArn String    @unique @map("endpoint_arn")
  // Android-only Phase 1; kept as a plain string (not an enum) for a future iOS value.
  platform    String    @default("android")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  // Set when the SNS endpoint is confirmed gone (EndpointDisabledException) or the
  // user explicitly unregisters (logout) — never hard-deleted, same soft-delete
  // discipline as every other domain row.
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@map("device_tokens")
}
